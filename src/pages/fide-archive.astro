---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHeader from '../components/ToolHeader.astro';
import manifestData from '../../public/data/fide-archive/standard-lists.json';
import originalDownloads from '../../public/data/fide-archive/pixeldrain.json';
import savedDownloads from '../../public/data/fide-archive/local-snapshots.json';
import { formatBytes } from '../lib/fide-archive';
import { parseStandardRatingManifest, ratingPeriodLabel } from '../lib/fide-standard-lists';

const manifest = parseStandardRatingManifest(manifestData);
const activeLists = manifest.lists.filter(row => !row.effectiveFrom || Date.parse(row.effectiveFrom) <= Date.now());
const number = (value: number) => value.toLocaleString('en-US');
const totalRows = activeLists.reduce((sum, row) => sum + row.rows, 0);
const references = [...originalDownloads.bundles, ...savedDownloads.bundles];
for (const file of references) {
  if (file.url !== `https://pixeldrain.com/u/${file.id}` || !/^[A-Za-z0-9]+$/.test(file.id) || !/^[a-f0-9]{64}$/.test(file.sha256) || file.bytes <= 0) throw new Error('Invalid original-file download.');
}
---
<BaseLayout title="FIDE Archive" description="Standard FIDE rating lists, with one SQLite database per available rating-list period.">
  <ToolHeader title="FIDE Archive" icon="history_edu" />
  <div class="fa">
    <p>One SQLite database per available rating-list period, containing standard ratings and player information.</p>
    <p class="fa-note" id="faSummary">{number(activeLists.length)} periods · {number(totalRows)} source rows · {activeLists.at(-1)!.period.slice(0, 4)}–{activeLists[0].period.slice(0, 4)}</p>
    <p class="fa-note">Extract the ZIP to open its SQLite database.</p>
    <p class="fa-note">Early lists were published less frequently, and some contain only partial lists or changes. These databases preserve the available rows and missing values; they do not reconstruct missing periods. Dates retain their original precision.</p>
    <p><a href="/fide-player.html">Look up a player’s rating history</a></p>
    <details class="fa-reference">
      <summary>Original files and player lists (Pixeldrain)</summary>
      <p>Reference downloads of the original files. The rating databases are listed separately below.</p>
      <ul>{references.map(file => <li><a href={file.url} target="_blank" rel="noopener noreferrer" title={`SHA-256 ${file.sha256}`}>{file.name}</a> · {formatBytes(file.bytes)}</li>)}</ul>
    </details>
    <div class="fa-controls">
      <label for="faSearch">Find a period</label>
      <input id="faSearch" type="search" placeholder="1985, Mar 2019, 2019-03…" autocomplete="off" />
    </div>
    <p id="faCount" class="fa-note" aria-live="polite">{number(activeLists.length)} periods</p>
    <table class="fa-table">
      <caption class="visually-hidden">Standard FIDE rating lists by period, newest first</caption>
      <thead><tr><th scope="col">Period</th><th scope="col">Rows</th><th scope="col">Download</th></tr></thead>
      <tbody id="faBody">
        {manifest.lists.map(row => (
          <tr data-search={`${row.period} ${ratingPeriodLabel(row.period)}`.toLowerCase()} data-period={row.period} data-rows={row.rows} data-effective={row.effectiveFrom ?? ''} hidden={!!row.effectiveFrom && Date.parse(row.effectiveFrom) > Date.now()}>
            <th scope="row"><time datetime={row.period}>{ratingPeriodLabel(row.period)}</time></th>
            <td class="fa-rows">{number(row.rows)}</td>
            <td><a href={row.url} title={`ZIP SHA-256 ${row.zipSha256}`} aria-label={`Download standard ratings ${ratingPeriodLabel(row.period)} as SQLite ZIP`}>SQLite ZIP</a><span class="fa-size">{formatBytes(row.zipBytes)}</span></td>
          </tr>
        ))}
        <tr id="faEmpty" hidden><td colspan="3">No periods match.</td></tr>
      </tbody>
    </table>
    <details class="fa-reference">
      <summary>Schema and sources</summary>
      <p>The <code>players</code> table holds names, FIDE IDs where available, federations, titles, birth information and standard ratings. It retains the existing 22-column schema, including source line numbers, ranks, rating changes, games, K-factors and flags where supplied. The <code>meta</code> table records the period and original source. Rapid and blitz ratings and combined player registries are excluded.</p>
      <p>Names and biographical fields are kept as recorded in each period. Missing information is not copied from later player lists. Duplicate source rows and historical partial lists are preserved.</p>
      <p><a href="/data/fide-archive/standard-lists.json">Download metadata and checksums</a> for each SQLite database and ZIP, including original source hashes and the source archive revision.</p>
      <p>Sources: <a href="https://ratings.fide.com/download_lists.phtml" target="_blank" rel="noopener noreferrer">FIDE rating lists</a> and <a href="https://www.olimpbase.org/Elo/summary.html" target="_blank" rel="noopener noreferrer">Olimpbase historical lists</a>. Original files and older player lists are retained separately as reference material. This is an independent archive.</p>
    </details>
  </div>
  <style>
    .fa > p { max-width: 78ch; margin-bottom: 0.9rem; }
    .fa-note { color: var(--text-secondary); font-size: 0.9rem; }
    .fa-controls { display: grid; gap: 0.35rem; max-width: 22rem; margin: 1.5rem 0 0.75rem; }
    .fa-controls label { font-size: 0.9rem; }
    .fa-controls input { width: 100%; padding: 0.5rem 0.65rem; border: 1px solid var(--border-color); border-radius: 5px; background: var(--bg-tertiary); color: var(--text-primary); }
    .fa-controls input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .fa-table { width: 100%; max-width: 65rem; border-collapse: collapse; font-size: 0.9rem; }
    .fa-table th, .fa-table td { padding: 0.7rem 0.65rem; border-bottom: 1px solid var(--border-color); vertical-align: top; text-align: left; }
    .fa-table thead th { background: var(--bg-secondary); }
    .fa-table th[scope="row"] { font-weight: 600; }
    .fa-rows { font-variant-numeric: tabular-nums; }
    .fa-size { display: inline-block; margin-left: 0.65rem; color: var(--text-secondary); font-size: 0.85rem; }
    .fa-reference { max-width: 78ch; margin-top: 1.5rem; color: var(--text-secondary); font-size: 0.9rem; }
    .fa-reference summary { color: var(--text-primary); cursor: pointer; margin-bottom: 0.75rem; }
    .fa-reference p { margin-bottom: 0.75rem; }
    .fa-reference li { margin-bottom: 0.4rem; overflow-wrap: anywhere; }
    @media (max-width: 480px) { .fa-table th, .fa-table td { padding: 0.6rem 0.3rem; } .fa-size { display: block; margin: 0.2rem 0 0; } }
    [hidden] { display: none !important; }
  </style>
  <script>
    import { untilUtcMidnight } from '../lib/fide-monthly';
    const input = document.getElementById('faSearch') as HTMLInputElement;
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#faBody tr[data-search]'));
    function filter() {
      const query = input.value.trim().toLowerCase();
      let count = 0;
      const active = rows.filter(row => !row.dataset.effective || Date.parse(row.dataset.effective) <= Date.now());
      rows.forEach(row => {
        row.hidden = !active.includes(row) || !row.dataset.search!.includes(query);
        if (!row.hidden) count++;
      });
      document.getElementById('faEmpty')!.hidden = count !== 0;
      document.getElementById('faCount')!.textContent = `${count.toLocaleString('en-US')} periods`;
      const total = active.reduce((sum, row) => sum + Number(row.dataset.rows), 0);
      document.getElementById('faSummary')!.textContent = `${active.length.toLocaleString('en-US')} periods · ${total.toLocaleString('en-US')} source rows · ${active.at(-1)!.dataset.period!.slice(0, 4)}–${active[0].dataset.period!.slice(0, 4)}`;
    }
    function schedule() { window.setTimeout(() => { filter(); schedule(); }, untilUtcMidnight()); }
    input.addEventListener('input', filter);
    document.addEventListener('visibilitychange', filter);
    filter();
    schedule();
  </script>
</BaseLayout>
