---
// The CCC archive is now a tab on the consolidated Chess.com Tournaments page.
// This route stays as a redirect so existing links keep working.
const target = '/chesscom-tournaments.html#ccc';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CCC Archive has moved</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="/chesscom-tournaments.html" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>The CCC archive is now a tab on <a href={target}>Chess.com Tournaments</a>. Redirecting…</p>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)});`}></script>
  </body>
</html>
