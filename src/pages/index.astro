---
import ToolCard from '../components/ToolCard.astro';
import { allTools, categoryHref, categoryLabels, toolCategories } from '../data/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Chess Nerd">
  <main>
    <h1 class="visually-hidden">Chess Nerd</h1>
    <nav class="category-nav home-category-nav" aria-label="Tool categories">
      <a class="category-chip active" href="/" aria-current="page">All <span>{allTools.length}</span></a>
      {toolCategories.map((category) => (
        <a class="category-chip" href={categoryHref(category)}>
          {categoryLabels[category]} <span>{allTools.filter((tool) => tool.category === category).length}</span>
        </a>
      ))}
    </nav>

    <section class="tool-grid" aria-label="Chess tools">
      {allTools.map((tool) => <ToolCard tool={tool} />)}
    </section>
  </main>
</BaseLayout>
