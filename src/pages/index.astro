---
import BaseLayout from '../layouts/BaseLayout.astro';
import OverviewTabs from '../components/OverviewTabs.astro';
import { Search, FileSearch, Swords, Palette, BookOpen, Cpu, RotateCcwClock } from '@lucide/astro';
import { tournamentArchivePath } from '../lib/curated-tournaments';

const tasks=[{name:'Inspect a PGN',description:'Players, openings, tags and results',href:'/pgn-info.html',icon:FileSearch},{name:'Play an engine',description:'A game against Lozza, in your browser',href:'/play-engine.html',icon:Swords},{name:'Explore openings',description:'ECO codes, named lines and boards',href:'/eco-code.html',icon:BookOpen},{name:'Design a board palette',description:'Colors and ready-to-use exports',href:'/board-colors.html',icon:Palette}];
---
<BaseLayout title="Chess Nerd" description="Search tournaments, download PGNs, look up player rating histories and use chess tools.">
  <main class="dashboard">
    <div class="dashboard-heading"><div><h1>Chess Nerd</h1></div></div>
    <OverviewTabs />
    <div class="dashboard-columns">
      <section id="games" aria-labelledby="archive-heading">
        <div class="section-title"><h2 id="archive-heading">Tournament archive</h2></div>
        <form class="archive-controls" id="tournament-search" action={tournamentArchivePath} method="get">
          <div class="field search-field">
            <label for="archive-query">Event, place or year</label>
            <input id="archive-query" name="q" type="search" placeholder="Try Olympiad or Wijk aan Zee…" />
          </div>
          <button class="btn btn-primary" type="submit"><Search size={15} aria-hidden="true" /> Search tournaments</button>
        </form>
        <div class="task-links"><a href={tournamentArchivePath}>Browse all selected tournaments →</a><a href="/pgn-downloads.html">PGN databases →</a></div>
      </section>
      <aside class="dashboard-rail" aria-label="More ways to explore">
        <section class="rail-section" id="players"><h2>Find a player</h2><form class="player-search" action="/fide-player.html" method="get"><label for="player-query">Surname or FIDE ID</label><input id="player-query" name="q" type="search" placeholder="Carlsen or 1503014" required minlength="2" /><button type="submit"><Search size={14} aria-hidden="true" /> Find player</button></form><div class="task-links"><a href="/fide-2500.html">Browse FIDE 2500+ players →</a><a href="/titled-players.html">Chess.com titled players →</a></div></section>
        <section class="rail-section" id="tools"><h2>Tools</h2><div class="task-links">{tasks.map(task=>{const Icon=task.icon;return <a href={task.href}><Icon size={17} aria-hidden="true" /><span>{task.name}<small>{task.description}</small></span></a>})}</div></section>
        <section class="rail-section"><h2>Data</h2><div class="task-links"><a href="/fide-archive.html"><RotateCcwClock size={16} aria-hidden="true" /><span>Historical FIDE rating lists</span></a><a href="/engines.html"><Cpu size={16} aria-hidden="true" /><span>Engine releases</span></a></div></section>
      </aside>
    </div>
  </main>
</BaseLayout>
<style>
  #tournament-search { align-items: end; border-radius: 5px; margin-bottom: 10px; }
</style>
<script src="../scripts/dashboard.ts"></script>
