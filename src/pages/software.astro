---
import ToolHeader from '../components/ToolHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { softwareGroups } from '../data/software';

const total = softwareGroups.reduce((count, group) => count + group.items.length, 0);
const platforms = ['Windows', 'macOS', 'Linux', 'Web', 'Library'];
---
<BaseLayout title="Software catalogue" description="Jupiter chess programs by Ian Rastall, plus chess databases, engine interfaces, training software, PGN utilities and developer libraries.">
  <main>
    <div class="tool-container software-catalogue">
      <ToolHeader title="Software catalogue" icon="inventory_2" />

      <form id="software-filters" class="software-filters" role="search" aria-label="Software catalogue" hidden>
        <div class="software-filter"><label for="software-query">Find software</label><input id="software-query" type="search" placeholder="Name, task or feature" /></div>
        <div class="software-filter"><label for="software-category">Category</label><select id="software-category"><option value="">All categories</option>{softwareGroups.map(group => <option value={group.id}>{group.name}</option>)}</select></div>
        <div class="software-filter"><label for="software-platform">Platform</label><select id="software-platform"><option value="">All platforms</option>{platforms.map(platform => <option>{platform}</option>)}</select></div>
        <button type="reset" class="btn btn-secondary">Clear</button>
      </form>

      <div class="catalogue-summary"><p id="software-count" role="status" aria-live="polite">{total} programs and libraries</p><p>Details checked <time datetime="2026-10-30">30 October 2026</time>.</p></div>
      <nav class="software-categories" aria-label="Software categories">{softwareGroups.map(group => <a href={`#${group.id}`}>{group.name.replace('My software · ', '')} <span>{group.items.length}</span></a>)}</nav>
      <p id="software-empty" hidden>No software matches these filters. Change the search or clear the filters.</p>

      {softwareGroups.map(group => (
        <section id={group.id} class:list={['software-section', `software-section--${group.id}`]} data-software-group aria-labelledby={`${group.id}-heading`}>
          <div class="software-section-heading"><h2 id={`${group.id}-heading`}>{group.name}</h2><span class="section-count">{group.items.length}</span></div>
          <p class="software-section-intro">{group.description}</p>
          {group.id === 'engines' && <p class="section-link"><a href="/engines.html">Browse engine releases</a> · <a href="/stockfish-commits.html">Stockfish development commits</a></p>}
          <div class="software-list">
            {group.items.map(item => (
              <article class="software-item" data-software-item data-category={group.id} data-platforms={item.platforms.join('|')} data-search={`${item.name} ${item.description} ${item.platforms.join(' ')} ${item.access} ${item.availability || ''} ${group.name}`.toLowerCase()}>
                <h3>{item.name}</h3>
                <p class="software-meta">{item.platforms.join(' / ')} <span aria-hidden="true">·</span> {item.access}</p>
                <p class="software-description">{item.description}</p>
                {item.availability && <p class="software-availability">{item.availability}</p>}
                {item.links.length > 0 && <ul class="software-item-links" aria-label={`${item.name} links`}>{item.links.map(link => <li><a href={link.url}>{link.label}</a></li>)}</ul>}
              </article>
            ))}
          </div>
        </section>
      ))}

      <aside class="software-resources" aria-label="Related resources"><h2>Related resources</h2><p><a href="https://sourceforge.net/p/scid/wiki/GetResources/">SCID resources</a>: compatible databases, player data, opening books, engines and tablebases.</p><p><a href="/pgn-downloads.html">PGN downloads</a> · <a href="/pgn-info.html">Inspect a PGN file in your browser</a></p></aside>
      <details class="earlier-software">
        <summary>Earlier software: PGN Simple Edit and PgnTools</summary>
        <p>These earlier releases remain available for existing users. Current Jupiter programs are listed above.</p>
        <ul>
          <li>PGN Simple Edit (Titania Tools), 0.1.0: file-level PGN reporting, joining, merging, splitting and sorting. <a href="https://github.com/ianrastall/titania-tools/releases/download/v0.1.0/PgnSimpleEdit-0.1.0-Setup.exe">Original installer</a> · <a href="https://github.com/ianrastall/titania-tools">Repository</a></li>
          <li>PGN Tools (PgnTools), 2.0.0: older Windows PGN utility. <a href="https://github.com/ianrastall/PgnTools/releases/download/2.0.0/PgnTools-2.0.0-win-x64.exe">Original download</a> · <a href="https://github.com/ianrastall/PgnTools">Repository</a></li>
        </ul>
      </details>
    </div>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>('#software-filters')!;
    const query = document.querySelector<HTMLInputElement>('#software-query')!;
    const category = document.querySelector<HTMLSelectElement>('#software-category')!;
    const platform = document.querySelector<HTMLSelectElement>('#software-platform')!;
    const items = [...document.querySelectorAll<HTMLElement>('[data-software-item]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-software-group]')];
    const count = document.querySelector<HTMLElement>('#software-count')!;
    const empty = document.querySelector<HTMLElement>('#software-empty')!;

    function filterSoftware() {
      const words = query.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const item of items) {
        item.hidden = !words.every(word => item.dataset.search!.includes(word))
          || (!!category.value && item.dataset.category !== category.value)
          || (!!platform.value && !item.dataset.platforms!.split('|').includes(platform.value));
        if (!item.hidden) visible++;
      }
      for (const group of groups) {
        const matches = group.querySelectorAll('[data-software-item]:not([hidden])').length;
        group.hidden = matches === 0;
        group.querySelector('.section-count')!.textContent = String(matches);
      }
      count.textContent = `${visible} of ${items.length} programs and libraries`;
      empty.hidden = visible !== 0;
    }

    form.hidden = false;
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('input', filterSoftware);
    form.addEventListener('change', filterSoftware);
    form.addEventListener('reset', () => {
      query.value = ''; category.value = ''; platform.value = '';
      filterSoftware();
    });
    document.querySelectorAll<HTMLAnchorElement>('.software-categories a').forEach(link => link.addEventListener('click', () => {
      form.reset();
    }));
    filterSoftware();
  </script>

  <style>
    .software-filters { display:grid; grid-template-columns:minmax(180px,2fr) minmax(160px,1.5fr) minmax(130px,1fr) auto; gap:12px; align-items:end; margin-bottom:12px; }
    .software-filter { display:grid; gap:6px; min-width:0; }
    .software-filters label { color:var(--muted); font-size:12px; }
    .software-filters input, .software-filters select { width:100%; }
    .software-filters button { min-height:38px; }
    .catalogue-summary { display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 16px; color:var(--muted); font-size:12px; margin-bottom:16px; }
    .catalogue-summary p { margin:0; }
    .software-categories { display:flex; flex-wrap:wrap; gap:8px 16px; padding-bottom:20px; border-bottom:1px solid var(--border); margin-bottom:28px; font-size:12px; }
    .software-categories span { color:var(--muted); margin-left:3px; }
    .software-section { --section-accent:var(--accent-strong); margin-bottom:32px; scroll-margin-top:24px; padding:20px; border-inline-start:4px solid var(--section-accent); border-radius:0 4px 4px 0; background:color-mix(in srgb,var(--section-accent) 12%,var(--bg)); }
    .software-section--databases, .software-section--tournaments { --section-accent:var(--info); }
    .software-section--interfaces, .software-section--engines { --section-accent:var(--danger); }
    .software-section--training { --section-accent:var(--success); }
    .software-section--pgn { --section-accent:var(--warning); }
    .software-section-heading { display:flex; gap:10px; align-items:baseline; margin-bottom:6px; }
    .software-section-heading h2, .software-resources h2 { font-size:18px; font-weight:600; margin:0; }
    .section-count { color:var(--muted); font-size:12px; }
    .software-section-intro { color:var(--muted); font-size:13px; margin-bottom:16px; max-width:80ch; }
    .section-link { font-size:13px; margin-bottom:16px; }
    .software-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    .software-item { display:flex; flex-direction:column; min-width:0; padding:20px; border:1px solid var(--border); border-radius:4px; background:var(--panel); }
    .software-item h3 { font-size:16px; font-weight:600; margin:0 0 6px; }
    .software-meta { color:var(--muted); font-size:11px; margin-bottom:12px; }
    .software-description { font-size:13px; line-height:1.6; margin-bottom:12px; }
    .software-availability { font-size:12px; line-height:1.5; color:var(--muted); margin-bottom:12px; }
    .software-item-links { display:flex; flex-wrap:wrap; gap:8px 16px; list-style:none; padding:0; margin:auto 0 0; font-size:12px; }
    .software-item-links a { display:inline-block; padding:4px 0; }
    .software-resources { border-top:1px solid var(--border); padding-top:20px; margin-bottom:24px; font-size:13px; }
    .software-resources h2 { margin-bottom:12px; }
    .earlier-software { padding:16px; border:1px solid var(--border); border-radius:4px; font-size:13px; }
    .earlier-software summary { cursor:pointer; }
    .earlier-software p { margin:16px 0; color:var(--muted); }
    .earlier-software ul { padding-left:20px; }
    .earlier-software li { margin-top:12px; line-height:1.6; }
    @media(max-width:1100px) { .software-filters { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:700px) { .software-list, .software-filters { grid-template-columns:minmax(0,1fr); } .software-section { padding:16px 12px; } .software-item { padding:16px; } }
    @media(forced-colors:active) { .software-section { border-color:Highlight; background:Canvas; } }
  </style>
</BaseLayout>
