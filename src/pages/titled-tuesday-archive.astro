---
import ToolHeader from '../components/ToolHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import manifest from '../../public/data/titled-tuesday-archive/manifest.json';
import { parseTitledTuesdayManifest } from '../lib/titled-tuesday-archive';

const entries = parseTitledTuesdayManifest(manifest);
const games = entries.reduce((sum, entry) => sum + entry.games, 0);
const latestDate = entries[0].date;
const sessionName = (session: string) => session === 'early' ? 'Early' : session === 'late' ? 'Late' : '';
const longDate = (value: string) => new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
const number = (value: number) => value.toLocaleString('en-US');
---
<BaseLayout title="Titled Tuesday Archive" description="Search Titled Tuesday events and download PGNs, with event dates and game counts.">
  <main>
    <div id="toolView" class="titled-tuesday-archive">
      <ToolHeader title="Titled Tuesday Archive" icon="event" />
      <p class="tt-intro">Titled Tuesday games, organized by event. Each ZIP contains a PGN file.</p>

      <div class="tt-summary">
        <p><strong>{number(entries.length)}</strong> events <span aria-hidden="true">·</span> <strong>{number(games)}</strong> games</p>
        <p>Latest archived event: <time datetime={latestDate}>{latestDate}</time></p>
        <a href="https://github.com/ianrastall/titled-tuesday-archive" target="_blank" rel="noopener noreferrer">Archive on GitHub <span aria-hidden="true">↗</span></a>
      </div>

      <div id="ttControls" class="tt-controls" hidden>
        <div class="tt-search">
          <label for="ttSearch">Search events</label>
          <input id="ttSearch" type="search" placeholder="Date, early, late, or filename…" autocomplete="off" />
        </div>
        <div class="tt-page-size">
          <label for="ttPageSize">Rows per page</label>
          <select id="ttPageSize">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100" selected>100</option>
          </select>
        </div>
      </div>

      <p id="ttStatus" class="tt-status" role="status">{number(entries.length)} events, newest first</p>
      <div class="tt-table-wrap" role="region" aria-label="Titled Tuesday event downloads" tabindex="0">
        <table class="tt-table">
          <caption class="visually-hidden">Titled Tuesday events, newest first</caption>
          <thead>
            <tr>
              <th scope="col">Event</th>
              <th scope="col">Date</th>
              <th scope="col">Session</th>
              <th scope="col" class="tt-number">Games</th>
              <th scope="col"><span class="visually-hidden">Download</span></th>
            </tr>
          </thead>
          <tbody id="ttTableBody">
            {entries.map((entry) => (
              <tr data-tt-entry data-search={`${entry.event} ${entry.pgn} ${entry.date} ${longDate(entry.date)} ${entry.session}`.toLowerCase()}>
                <th scope="row">
                  <span class="tt-event">Titled Tuesday{entry.session ? ` · ${sessionName(entry.session)}` : ''}</span>
                  <span class="tt-filename">{entry.pgn}</span>
                </th>
                <td class="tt-date"><time datetime={entry.date}>{entry.date}</time></td>
                <td>{sessionName(entry.session) || '—'}</td>
                <td class="tt-number">{number(entry.games)}</td>
                <td><a class="btn btn-secondary btn-compact tt-download" href={entry.url} aria-label={`Download Titled Tuesday ${entry.date}${entry.session ? ` ${sessionName(entry.session)}` : ''} PGN ZIP`}><span class="material-icons" aria-hidden="true">download</span>ZIP</a></td>
              </tr>
            ))}
            <tr id="ttEmpty" hidden><td colspan="5">No events match your search. Try another name or date.</td></tr>
          </tbody>
        </table>
      </div>
      <nav id="ttPagination" class="tt-pagination" aria-label="Archive pages" hidden>
        <button id="ttPrevPage" type="button" class="btn btn-secondary" disabled>Previous</button>
        <span id="ttPageInfo">Page 1 of 1</span>
        <button id="ttNextPage" type="button" class="btn btn-secondary">Next</button>
      </nav>
      <p class="tt-note">This is a growing collection; some events are not yet archived.</p>
      <noscript><p class="tt-note">All events are listed. Enable JavaScript for search and pagination.</p></noscript>
    </div>
  </main>

  <style>
    .tt-intro { margin-bottom: 1rem; }
    .tt-summary { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: 1.5rem; color: var(--text-secondary); font-size: 0.9rem; }
    .tt-summary strong { color: var(--text-primary); }
    .tt-summary p:first-child span { padding: 0 0.4rem; }
    .tt-controls { display: flex; align-items: end; gap: 1rem; margin-bottom: 1rem; }
    .tt-controls[hidden], .tt-pagination[hidden] { display: none; }
    .tt-search { flex: 1; }
    .tt-controls label { display: block; font-size: 0.9rem; margin-bottom: 0.4rem; }
    .tt-controls input, .tt-controls select { width: 100%; min-height: 2.75rem; padding: 0.6rem 0.75rem; color: var(--text-primary); background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 6px; font: inherit; }
    .titled-tuesday-archive :is(input, select, a, button, [tabindex]):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .tt-status { margin-bottom: 0.75rem; color: var(--text-secondary); font-size: 0.9rem; }
    .tt-table-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 8px; }
    .tt-table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); }
    .tt-table th, .tt-table td { padding: 0.85rem 1rem; text-align: left; border-bottom: 1px solid var(--border-color); }
    .tt-table thead th { background: var(--bg-tertiary); color: var(--text-secondary); font-size: 0.875rem; font-weight: 600; }
    .tt-table tbody th { font-weight: 400; min-width: 18rem; }
    .tt-table tbody tr:hover { background: var(--bg-tertiary); }
    .tt-event { display: block; font-weight: 600; }
    .tt-filename { display: block; margin-top: 0.2rem; font-size: 0.875rem; color: var(--text-secondary); overflow-wrap: anywhere; }
    .tt-table .tt-number { text-align: right; font-variant-numeric: tabular-nums; }
    .tt-date { white-space: nowrap; font-variant-numeric: tabular-nums; font-size: 0.9rem; }
    .tt-download { white-space: nowrap; min-height: 2.5rem; }
    .tt-pagination { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
    .tt-pagination span, .tt-note { color: var(--text-secondary); font-size: 0.9rem; }
    .tt-pagination button:disabled { opacity: 0.45; cursor: default; }
    .tt-note { margin-top: 1rem; }
    @media (max-width: 600px) {
      .tt-controls { align-items: stretch; flex-direction: column; }
      .tt-table th, .tt-table td { padding: 0.75rem; }
      .tt-pagination { justify-content: center; gap: 0.6rem; }
    }
  </style>
  <script>
    import '../scripts/titled-tuesday-archive';
  </script>
</BaseLayout>
