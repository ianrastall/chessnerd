---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHeader from '../components/ToolHeader.astro';

// Where the player files live: the fide-players repo, served by GitHub Pages. Set
// PUBLIC_FIDE_PLAYERS_BASE (a URL ending in /) to read them from somewhere else; local
// development uses /fide-players/ via .env.development.
const base = import.meta.env.PUBLIC_FIDE_PLAYERS_BASE ?? 'https://ianrastall.github.io/fide-players/';
---
<BaseLayout title="FIDE Player Profiles" description="Look up a FIDE-rated player and see their full rating history from the archived FIDE rating lists, 1967 to now.">
  <ToolHeader title="FIDE Player Profiles" icon="person_search" backHref="/fide-archive.html" />
  <div class="fp" id="fpRoot" data-base={base}>
    <p class="fp-intro">
      A player’s whole rating history, built from the <a href="/fide-archive.html">archived FIDE lists</a>. Search by surname, or go straight to a FIDE ID.
      Standard ratings, 1967 to now; players are tied together by FIDE ID, so lists from before IDs existed are not part of a profile.
    </p>

    <div class="fp-controls">
      <div class="fp-field">
        <label for="fpSearch">Search by name</label>
        <input id="fpSearch" type="search" placeholder="Carlsen, or Carlsen Magnus" autocomplete="off" />
      </div>
      <form id="fpIdForm" class="fp-field fp-id">
        <label for="fpId">FIDE ID</label>
        <div class="fp-id-row">
          <input id="fpId" inputmode="numeric" pattern="[0-9]*" placeholder="1503014" autocomplete="off" />
          <button class="btn btn-secondary" type="submit">Open</button>
        </div>
      </form>
    </div>

    <p id="fpStatus" class="fp-status" role="status" aria-live="polite"></p>
    <div id="fpResults"></div>
    <section id="fpProfile" aria-label="Player profile" hidden></section>
    <noscript><p class="fp-note">This page needs JavaScript to read the player files.</p></noscript>
  </div>

  <style is:global>
    .fp-intro { max-width: 70ch; margin-bottom: 1rem; color: var(--text-secondary); font-size: 0.92rem; }
    .fp-controls { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; margin-bottom: 0.75rem; }
    .fp-field { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
    .fp-field label { font-size: 0.8rem; color: var(--text-secondary); }
    .fp-field input { background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 5px; color: var(--text-primary); padding: 0.4rem 0.6rem; height: 2.2rem; font-size: 0.9rem; min-width: 0; }
    .fp-field input:focus { outline: none; border-color: var(--accent); }
    #fpSearch { width: min(26rem, 80vw); }
    .fp-id-row { display: flex; gap: 0.5rem; }
    #fpId { width: 9.5rem; }
    .fp-status { min-height: 1.4rem; color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 0.6rem; }
    .fp-table-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 10px; margin: 0.6rem 0; }
    .fp-table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
    .fp-table thead th { text-align: left; padding: 0.5rem 0.75rem; background: var(--bg-secondary); color: var(--text-secondary); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid var(--border-color); white-space: nowrap; }
    .fp-table th[scope="row"], .fp-table td { padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--border-color); text-align: left; }
    .fp-table tbody tr:last-child > * { border-bottom: none; }
    .fp-table tbody tr:hover > * { background: rgba(var(--accent-rgb), 0.04); }
    .fp-table .fp-num { text-align: right; font-variant-numeric: tabular-nums; }
    .fp-head { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem; margin-bottom: 0.6rem; }
    .fp-head h2 { margin: 0; font-size: 1.4rem; }
    .fp-title-badge { padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.78rem; font-weight: 700; background: rgba(var(--accent-rgb), 0.18); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), 0.35); }
    .fp-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.6rem; margin: 0 0 1rem; }
    .fp-stats > div { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 0.5rem 0.75rem; }
    .fp-stats dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-secondary); }
    .fp-stats dd { margin: 0.1rem 0 0; font-size: 1rem; font-weight: 600; }
    #fpProfile h3 { margin: 1.25rem 0 0.4rem; font-size: 1.05rem; }
    #fpProfile p { margin: 0.35rem 0; font-size: 0.9rem; }
    .fp-toggles { display: flex; gap: 1rem; font-size: 0.85rem; margin-bottom: 0.3rem; }
    .fp-chart-wrap { border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-secondary); padding: 0.4rem; }
    .fp-chart { width: 100%; height: auto; display: block; touch-action: pan-y; }
    .fp-grid { stroke: var(--border-color); stroke-width: 1; }
    .fp-axis { fill: var(--text-secondary); font-size: 11px; }
    .fp-readout { fill: var(--text-primary); font-size: 12px; }
    .fp-cursor { stroke: var(--text-secondary); stroke-dasharray: 3 3; }
    .fp-actions { display: flex; gap: 0.5rem; margin: 0.6rem 0; }
    .fp-note { color: var(--text-secondary); font-size: 0.82rem; max-width: 80ch; }
    #fpProfile[hidden] { display: none; }
  </style>

  <script>
    import '../scripts/fide-player';
  </script>
</BaseLayout>
