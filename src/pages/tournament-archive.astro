---
import BulletBrawlArchivePanel from '../components/BulletBrawlArchivePanel.astro';
import CccArchivePanel from '../components/CccArchivePanel.astro';
import ThreeZeroThursdayArchivePanel from '../components/ThreeZeroThursdayArchivePanel.astro';
import TitledTuesdayArchivePanel from '../components/TitledTuesdayArchivePanel.astro';
import ToolHeader from '../components/ToolHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowDownToLine } from '@lucide/astro';
import { loadCuratedTournaments, sourceRepos, tournamentDates, tournamentZipPath } from '../lib/curated-tournaments';

const entries = await loadCuratedTournaments();
const years = [...new Set(entries.map(entry => entry.year))];
const number = (value: number | null) => value == null ? '—' : value.toLocaleString('en-US', { maximumFractionDigits: 3 });
const series = [
  { id: 'titled-tuesday', name: 'Titled Tuesday', Panel: TitledTuesdayArchivePanel },
  { id: 'bullet-brawl', name: 'Bullet Brawl', Panel: BulletBrawlArchivePanel },
  { id: 'three-zero-thursday', name: '3-0 Thursday', Panel: ThreeZeroThursdayArchivePanel },
  { id: 'ccc', name: 'CCC', Panel: CccArchivePanel },
];
---
<BaseLayout title="Tournament Archive" description="Browse major chess tournaments and download games from Titled Tuesday, Bullet Brawl, 3-0 Thursday, and the Computer Chess Championship.">
  <main id="toolView" class="tournament-archive">
    <ToolHeader title="Tournament Archive" icon="emoji_events" />

    <nav class="dashboard-tabs tournament-tabs" aria-label="Tournament collections">
      <a id="tab-events" href="#events">Selected tournaments</a>
      {series.map(({ id, name }) => <a id={`tab-${id}`} href={`#${id}`}>{name}</a>)}
    </nav>

    <section class="tournament-panel curated-panel" id="events" aria-labelledby="tab-events">
      <div class="tournament-intro">
        <p>Tournaments averaging 2700+ Elo and selected major events, including the Chess Olympiad.</p>
        <a class="btn btn-secondary btn-compact" href={tournamentZipPath} download>
          <ArrowDownToLine size={15} aria-hidden="true" /> Download table (CSV ZIP)
        </a>
      </div>

      <form class="tournament-controls archive-controls" id="tournament-controls" hidden>
        <div class="field search-field">
          <label for="tournament-query">Event, place or year</label>
          <input id="tournament-query" name="q" type="search" placeholder="Search tournaments…" autocomplete="off" />
        </div>
        <div class="field">
          <label for="tournament-year">Year</label>
          <select id="tournament-year" name="year">
            <option value="">All years</option>
            {years.map(year => <option value={year}>{year}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="tournament-sort">Sort by</label>
          <select id="tournament-sort" name="sort">
            <option value="">Newest first</option>
            <option value="elo">Highest average Elo</option>
            <option value="games">Most games</option>
            <option value="players">Most players</option>
          </select>
        </div>
      </form>

      <div class="archive-summary">
        <span id="tournament-count" role="status">{number(entries.length)} tournaments</span>
        <button class="btn btn-secondary btn-compact" id="tournament-clear" type="button" hidden>Clear filters</button>
      </div>

      <div class="archive-table-wrap tournament-table-wrap" role="region" aria-label="Tournament downloads" tabindex="0">
        <table class="tournament-table">
          <caption class="visually-hidden">Tournament archive</caption>
          <thead>
            <tr>
              <th scope="col">Tournament</th>
              <th scope="col" class="desktop-detail">Dates</th>
              <th scope="col" class="number desktop-detail">Category</th>
              <th scope="col" class="number desktop-detail">Average Elo</th>
              <th scope="col" class="number desktop-detail">Games</th>
              <th scope="col" class="number desktop-detail">Players</th>
              <th scope="col">Download</th>
            </tr>
          </thead>
          <tbody id="tournament-results">
            {entries.map(entry => {
              const { start, end } = tournamentDates(entry);
              const location = [entry.place, entry.source, entry.historical && 'Historical ratings'].filter(Boolean).join(' · ');
              return (
                <tr data-search={`${entry.name} ${entry.sourceName} ${entry.place} ${start} ${end}`.toLowerCase()}
                    data-year={entry.year} data-elo={entry.avgRating ?? -1} data-games={entry.games} data-players={entry.players ?? -1}>
                  <th scope="row">
                    <span class="tournament-name">{entry.name}</span>
                    <small>{location}</small>
                    <small class="mobile-detail">
                      {start}{start !== end && ` to ${end}`}<br />
                      Category {number(entry.category)} · Elo {number(entry.avgRating)}<br />
                      {number(entry.games)} games · {number(entry.players)} players
                    </small>
                  </th>
                  <td class="desktop-detail">
                    <time datetime={start}>{start}</time>
                    {start !== end && <><br /><span class="visually-hidden"> to </span><time datetime={end}>{end}</time></>}
                  </td>
                  <td class="number desktop-detail">{number(entry.category)}</td>
                  <td class="number desktop-detail">{number(entry.avgRating)}</td>
                  <td class="number desktop-detail">{number(entry.games)}</td>
                  <td class="number desktop-detail">{number(entry.players)}</td>
                  <td><a class="tournament-download" href={entry.url} title={`SHA-256: ${entry.sha256}`} aria-label={`Download ${entry.name} games ZIP`}>
                    <ArrowDownToLine size={14} aria-hidden="true" /> ZIP
                  </a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p id="tournament-empty" class="archive-empty" hidden>No tournaments match these filters.</p>
      <div class="archive-pagination" id="tournament-pagination" hidden>
        <button type="button" id="tournament-previous">← Previous</button>
        <span id="tournament-page"></span>
        <button type="button" id="tournament-next">Next →</button>
      </div>
      <p class="archive-note">
        Game counts refer to the games in each ZIP. Some historical files cover only part of the event, and their Elo values can be retrospective estimates.
        A dash indicates unavailable or inapplicable data. Sources
        <a href={sourceRepos['cc-events-archive']}>cc-events-archive</a> and <a href={sourceRepos.PgnTours}>PgnTours</a>.
      </p>
    </section>

    {series.map(({ id, Panel }) => (
      <section class="tournament-panel" id={id} aria-labelledby={`tab-${id}`}>
        <Panel />
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .tournament-archive, .curated-panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .tournament-tabs { margin-bottom: 0; }
  .tournament-archive:not([data-tabs-ready]):has(.tournament-panel:target) .tournament-panel:not(:target),
  .tournament-archive:not([data-tabs-ready]):not(:has(.tournament-panel:target)) .tournament-panel:not(#events) {
    display: none;
  }
  .tournament-intro { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .tournament-intro p { color: var(--muted); margin: 0; }
  .mobile-detail { display: none; }
  .tournament-controls { border-radius: 5px; }
  .archive-summary, .archive-pagination { padding: 0; margin: 0; }
  .tournament-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  .tournament-table th, .tournament-table td { padding: 10px 12px; text-align: left; vertical-align: top; }
  .tournament-table thead { background: var(--panel); color: var(--muted); }
  .tournament-table thead th { font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
  .tournament-table tbody tr { border-top: 1px solid var(--border); }
  .tournament-table tbody tr:hover { background: var(--panel); }
  .tournament-table .number { text-align: right; font-variant-numeric: tabular-nums; }
  .tournament-table time, .tournament-table small { color: var(--muted); }
  .tournament-table time { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .tournament-name { display: block; overflow-wrap: anywhere; }
  .tournament-table small { font-weight: 400; }
  .tournament-download { display: inline-flex; gap: 5px; align-items: center; white-space: nowrap; }
  @media (max-width: 640px) {
    .desktop-detail { display: none; }
    .mobile-detail { display: block; margin-top: 4px; }
    .tournament-download { min-height: 34px; }
  }
</style>

<script>
  import '../scripts/tournament-archive';
  import '../scripts/tournament-tabs';
</script>
