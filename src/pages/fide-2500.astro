---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolHeader from '../components/ToolHeader.astro';
---
<BaseLayout title="FIDE 2500+ Players" description="Filter FIDE-rated players whose standard, rapid, or blitz rating is at least 2500.">
<style is:global>
/* ── Layout ───────────────────────────────────────────── */
#fpView{display:flex;flex-direction:column;gap:1rem}

/* ── Filter panel ─────────────────────────────────────── */
.fp-filters{background:var(--bg-secondary);border:1px solid var(--border-color);border-radius:10px;padding:.9rem 1.1rem;display:flex;flex-direction:column;gap:.75rem}
.fp-title-row{display:flex;align-items:center;flex-wrap:wrap;gap:.45rem}
.fp-title-row label{font-size:.78rem;font-weight:600;color:var(--text-secondary);margin-right:.2rem}
.fp-title-btn{display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .55rem;border-radius:5px;border:1px solid var(--border-color);background:var(--bg-tertiary);color:var(--text-secondary);font-size:.78rem;font-weight:600;cursor:pointer;user-select:none;transition:background .12s,border-color .12s,color .12s}
.fp-title-btn input{display:none}
.fp-title-btn.checked{background:rgba(var(--accent-rgb),.15);border-color:var(--accent);color:var(--accent)}
.fp-title-sep{width:1px;height:1.2em;background:var(--border-color);margin:0 .1rem}
.fp-toggle-btn{padding:.25rem .55rem;border-radius:5px;border:1px solid var(--border-color);background:transparent;color:var(--text-secondary);font-size:.75rem;cursor:pointer;transition:color .12s,border-color .12s}
.fp-toggle-btn:hover{color:var(--accent);border-color:var(--accent)}
.fp-row2{display:flex;flex-wrap:wrap;gap:.6rem;align-items:flex-end}
.fp-field{display:flex;flex-direction:column;gap:.3rem;min-width:0}
.fp-field label{font-size:.75rem;color:var(--text-secondary)}
.fp-field select,.fp-field input[type="number"],.fp-field input[type="text"],.fp-field input[type="search"]{background:var(--bg-tertiary);border:1px solid var(--border-color);border-radius:5px;color:var(--text-primary);padding:.35rem .55rem;font-size:.85rem;height:2rem;min-width:0}
.fp-field select:focus,.fp-field input:focus{outline:none;border-color:var(--accent)}
.fp-field.wide{flex:1;min-width:180px}

/* ── Status bar ───────────────────────────────────────── */
.fp-status-bar{display:flex;align-items:center;flex-wrap:wrap;gap:.65rem;font-size:.83rem;color:var(--text-secondary)}
.fp-count{font-weight:600;color:var(--text-primary)}
.fp-updated{margin-left:auto;font-size:.78rem}
.fp-export{margin-left:auto}

/* ── Table ────────────────────────────────────────────── */
.fp-table-wrap{overflow-x:auto;border:1px solid var(--border-color);border-radius:10px}
.fp-table{width:100%;border-collapse:collapse;font-size:.86rem}
.fp-table th{padding:.5rem .75rem;background:var(--bg-secondary);color:var(--text-secondary);font-size:.74rem;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap;border-bottom:2px solid var(--border-color);cursor:pointer;user-select:none;position:sticky;top:0;z-index:1}
.fp-table th:hover{color:var(--accent)}
.fp-table th .sort-arrow{display:inline-block;margin-left:.3rem;opacity:.35;font-size:.7rem}
.fp-table th.sort-asc .sort-arrow::after{content:"▲";opacity:1}
.fp-table th.sort-desc .sort-arrow::after{content:"▼";opacity:1}
.fp-table th:not(.sort-asc):not(.sort-desc) .sort-arrow::after{content:"⇅"}
.fp-table td{padding:.45rem .75rem;border-bottom:1px solid var(--border-color);vertical-align:middle}
.fp-table tbody tr:last-child td{border-bottom:none}
.fp-table tbody tr:hover td{background:rgba(var(--accent-rgb),.04)}
.fp-table td.td-rating{font-family:Consolas,Monaco,monospace;text-align:right;font-size:.84rem}
.fp-table td.td-dash{color:var(--text-secondary)}
.fp-table td.td-name a{color:var(--accent);text-decoration:none;font-weight:500}
.fp-table td.td-name a:hover{text-decoration:underline}
.fp-table td.td-country,.fp-table td.td-sex,.fp-table td.td-born{color:var(--text-secondary)}

/* ── Title badge ──────────────────────────────────────── */
.title-badge{display:inline-block;padding:.15rem .4rem;border-radius:4px;font-size:.72rem;font-weight:700;letter-spacing:.04em;line-height:1.3}
.title-badge.men{background:rgba(var(--accent-rgb),.18);color:var(--accent);border:1px solid rgba(var(--accent-rgb),.35)}
.title-badge.women{background:transparent;color:var(--accent);border:1px solid var(--accent);opacity:.8}
.title-badge.none{background:transparent;color:var(--text-secondary);border:1px dashed var(--border-color);font-weight:400}

/* ── Status badge ─────────────────────────────────────── */
.status-badge{display:inline-block;padding:.1rem .35rem;border-radius:4px;font-size:.7rem;font-weight:600}
.status-badge.active{background:rgba(34,197,94,.15);color:#22c55e}
.status-badge.inactive{background:rgba(var(--accent-rgb),.07);color:var(--text-secondary)}

/* ── Footer ───────────────────────────────────────────── */
.fp-footer{display:flex;align-items:center;gap:1rem;padding:.5rem 0}
.fp-show-more{font-size:.85rem}
.fp-page-info{font-size:.8rem;color:var(--text-secondary)}
.fp-empty{padding:1.5rem;background:var(--bg-secondary);border:1px solid var(--border-color);border-radius:10px;color:var(--text-secondary);text-align:center}

@media(max-width:700px){
  .fp-row2{flex-direction:column}
  .fp-field{width:100%}
}
</style>

<main>
<div class="tool-container">
  <ToolHeader title="FIDE 2500+ Players" icon="groups" />

  <div id="fpView">

    <!-- Filters -->
    <div class="fp-filters">
      <div class="fp-title-row">
        <label>Titles</label>
        {["GM","WGM","IM","WIM","FM","WFM","CM","WCM","NM","WNM","Untitled"].map(t => (
          <label class="fp-title-btn checked" data-title={t}>
            <input type="checkbox" aria-label={`Toggle title ${t}`} checked />{t}
          </label>
        ))}
        <span class="fp-title-sep"></span>
        <button class="fp-toggle-btn" id="fpSelectAll">All</button>
        <button class="fp-toggle-btn" id="fpSelectNone">None</button>
      </div>

      <div class="fp-row2">
        <div class="fp-field">
          <label for="fpRating">Rating type</label>
          <select id="fpRating" aria-label="Rating format used for min-rating filter and sort">
            <option value="std">Standard</option>
            <option value="rapid">Rapid</option>
            <option value="blitz">Blitz</option>
            <option value="best">Best of 3</option>
          </select>
        </div>
        <div class="fp-field">
          <label for="fpMinElo">Min Elo</label>
          <input type="number" id="fpMinElo" value="0" min="0" max="4000" step="50" style="width:90px" aria-label="Minimum Elo rating" />
        </div>
        <div class="fp-field">
          <label for="fpCountry">Country</label>
          <input type="text" id="fpCountry" placeholder="e.g. USA" maxlength="4" style="width:90px;text-transform:uppercase" aria-label="Country code (FIDE federation)" />
        </div>
        <div class="fp-field">
          <label for="fpSex">Sex</label>
          <select id="fpSex" aria-label="Player sex">
            <option value="all">All</option>
            <option value="M">Men</option>
            <option value="F">Women</option>
          </select>
        </div>
        <div class="fp-field">
          <label for="fpStatus">Status</label>
          <select id="fpStatus" aria-label="Player activity status">
            <option value="all">All</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
        <div class="fp-field wide">
          <label for="fpSearch">Search name or FIDE ID</label>
          <input type="search" id="fpSearch" placeholder="Search…" autocomplete="off" aria-label="Search players" />
        </div>
      </div>
    </div>

    <!-- Status bar -->
    <div class="fp-status-bar">
      <span id="fpCount" class="fp-count">Loading…</span>
      <button class="btn btn-secondary btn-compact fp-export" id="fpExport" disabled>
        <span class="material-icons">download</span>Export CSV
      </button>
      <span id="fpUpdated" class="fp-updated"></span>
    </div>

    <!-- Table -->
    <div class="fp-table-wrap" id="fpTableWrap">
      <table class="fp-table" id="fpTable">
        <thead>
          <tr>
            <th data-col="title">Title<span class="sort-arrow"></span></th>
            <th data-col="name" class="sort-asc">Name<span class="sort-arrow"></span></th>
            <th data-col="country">Country<span class="sort-arrow"></span></th>
            <th data-col="sex">Sex<span class="sort-arrow"></span></th>
            <th data-col="std" style="text-align:right">Std<span class="sort-arrow"></span></th>
            <th data-col="rapid" style="text-align:right">Rapid<span class="sort-arrow"></span></th>
            <th data-col="blitz" style="text-align:right">Blitz<span class="sort-arrow"></span></th>
            <th data-col="born">Born<span class="sort-arrow"></span></th>
            <th data-col="active">Status<span class="sort-arrow"></span></th>
          </tr>
        </thead>
        <tbody id="fpBody"></tbody>
      </table>
    </div>

    <!-- Footer -->
    <div class="fp-footer">
      <button class="btn btn-secondary fp-show-more" id="fpShowMore" style="display:none">
        Show more
      </button>
      <span class="fp-page-info" id="fpPageInfo"></span>
    </div>

  </div>
</div>
</main>

<script>
const TITLE_PRIORITY: Record<string, number> = {GM:0,IM:1,WGM:2,FM:3,WIM:4,CM:5,WFM:6,NM:7,WCM:8,WNM:9};
const WOMEN_TITLES = new Set(["WGM","WIM","WFM","WNM","WCM"]);
const PAGE_SIZE = 100;

type Player = {
  id: number; name: string; country: string; sex: string;
  title: string; std: number; rapid: number; blitz: number;
  born: number | null; active: boolean;
};

type Meta = { source: string; period: string; generated: string; count: number; min_rating: number };

// State
let allPlayers: Player[] = [];
let filtered: Player[] = [];
let shownCount = PAGE_SIZE;
let sortCol = "name";
let sortDir: "asc" | "desc" = "asc";

// --- DOM refs ---
const fpBody = document.getElementById("fpBody") as HTMLTableSectionElement;
const fpCount = document.getElementById("fpCount")!;
const fpUpdated = document.getElementById("fpUpdated")!;
const fpExport = document.getElementById("fpExport") as HTMLButtonElement;
const fpShowMore = document.getElementById("fpShowMore") as HTMLButtonElement;
const fpPageInfo = document.getElementById("fpPageInfo")!;
const fpSearch = document.getElementById("fpSearch") as HTMLInputElement;
const fpRating = document.getElementById("fpRating") as HTMLSelectElement;
const fpMinElo = document.getElementById("fpMinElo") as HTMLInputElement;
const fpCountry = document.getElementById("fpCountry") as HTMLInputElement;
const fpSex = document.getElementById("fpSex") as HTMLSelectElement;
const fpStatus = document.getElementById("fpStatus") as HTMLSelectElement;
const titleBtns = Array.from(document.querySelectorAll<HTMLElement>(".fp-title-btn"));

function selectedTitles(): Set<string> {
  return new Set(titleBtns.filter(b => b.classList.contains("checked")).map(b => b.dataset.title!));
}

function ratingVal(p: Player): number {
  const t = fpRating.value;
  if (t === "std") return p.std;
  if (t === "rapid") return p.rapid;
  if (t === "blitz") return p.blitz;
  return Math.max(p.std, p.rapid, p.blitz);
}

function playerTitleKey(p: Player): string {
  return p.title || "Untitled";
}

function applyFilters(): void {
  const titles = selectedTitles();
  const minElo = parseInt(fpMinElo.value, 10) || 0;
  const country = fpCountry.value.trim().toUpperCase();
  const sex = fpSex.value;
  const status = fpStatus.value;
  const q = fpSearch.value.trim().toLowerCase();

  filtered = allPlayers.filter(p => {
    if (!titles.has(playerTitleKey(p))) return false;
    if (country && p.country !== country) return false;
    if (sex !== "all" && p.sex !== sex) return false;
    if (status === "active" && !p.active) return false;
    if (status === "inactive" && p.active) return false;
    if (minElo > 0 && ratingVal(p) < minElo) return false;
    if (q) {
      if (!p.name.toLowerCase().includes(q) && String(p.id) !== q) return false;
    }
    return true;
  });

  applySortInPlace();
  shownCount = PAGE_SIZE;
  render();
}

function applySortInPlace(): void {
  const dir = sortDir === "asc" ? 1 : -1;
  filtered.sort((a, b) => {
    let va: string | number = 0, vb: string | number = 0;
    if (sortCol === "title") {
      va = TITLE_PRIORITY[a.title] ?? 99;
      vb = TITLE_PRIORITY[b.title] ?? 99;
    } else if (sortCol === "std" || sortCol === "rapid" || sortCol === "blitz") {
      va = a[sortCol]; vb = b[sortCol];
    } else if (sortCol === "born") {
      va = a.born ?? 0; vb = b.born ?? 0;
    } else if (sortCol === "active") {
      va = a.active ? 0 : 1; vb = b.active ? 0 : 1;
    } else if (sortCol === "name") {
      va = a.name.toLowerCase(); vb = b.name.toLowerCase();
    } else if (sortCol === "country") {
      va = a.country; vb = b.country;
    } else if (sortCol === "sex") {
      va = a.sex; vb = b.sex;
    }
    if (va < vb) return -1 * dir;
    if (va > vb) return 1 * dir;
    return a.name.localeCompare(b.name) * dir;
  });
}

function ratingCell(val: number): string {
  if (!val) return `<td class="td-rating td-dash">—</td>`;
  return `<td class="td-rating">${val.toLocaleString()}</td>`;
}

function titleBadge(t: string): string {
  if (!t) return `<span class="title-badge none">—</span>`;
  const cls = WOMEN_TITLES.has(t) ? "women" : "men";
  return `<span class="title-badge ${cls}">${t}</span>`;
}

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function render(): void {
  const slice = filtered.slice(0, shownCount);
  const rows = slice.map(p => {
    const born = p.born ? `<td class="td-born">${p.born}</td>` : `<td class="td-born td-dash">—</td>`;
    const status = `<span class="status-badge ${p.active ? "active" : "inactive"}">${p.active ? "active" : "inactive"}</span>`;
    return `<tr>
      <td>${titleBadge(p.title)}</td>
      <td class="td-name"><a href="https://ratings.fide.com/profile/${p.id}" target="_blank" rel="noopener">${esc(p.name)}</a></td>
      <td class="td-country">${p.country || "—"}</td>
      <td class="td-sex">${p.sex || "—"}</td>
      ${ratingCell(p.std)}
      ${ratingCell(p.rapid)}
      ${ratingCell(p.blitz)}
      ${born}
      <td>${status}</td>
    </tr>`;
  }).join("");

  fpBody.innerHTML = rows || `<tr><td colspan="9" style="text-align:center;padding:1.5rem;color:var(--text-secondary)">No players match the current filters.</td></tr>`;

  const total = filtered.length;
  const shown = Math.min(shownCount, total);
  fpCount.textContent = `${total.toLocaleString()} of ${allPlayers.length.toLocaleString()} players`;
  fpShowMore.style.display = shown < total ? "" : "none";
  fpPageInfo.textContent = shown < total ? `Showing ${shown.toLocaleString()} of ${total.toLocaleString()}` : `Showing all ${total.toLocaleString()}`;
}

// --- Sort headers ---
document.querySelectorAll<HTMLTableCellElement>(".fp-table th[data-col]").forEach(th => {
  th.addEventListener("click", () => {
    const col = th.dataset.col!;
    if (sortCol === col) {
      sortDir = sortDir === "asc" ? "desc" : "asc";
    } else {
      sortCol = col;
      sortDir = ["std","rapid","blitz","born"].includes(col) ? "desc" : "asc";
    }
    document.querySelectorAll(".fp-table th").forEach(h => h.classList.remove("sort-asc","sort-desc"));
    th.classList.add(sortDir === "asc" ? "sort-asc" : "sort-desc");
    applySortInPlace();
    shownCount = PAGE_SIZE;
    render();
  });
});

// --- Title toggle buttons ---
titleBtns.forEach(btn => {
  btn.addEventListener("click", (e) => {
    e.preventDefault();
    btn.classList.toggle("checked");
    const cb = btn.querySelector("input") as HTMLInputElement;
    cb.checked = btn.classList.contains("checked");
    applyFilters();
  });
});

document.getElementById("fpSelectAll")!.addEventListener("click", () => {
  titleBtns.forEach(b => { b.classList.add("checked"); (b.querySelector("input") as HTMLInputElement).checked = true; });
  applyFilters();
});
document.getElementById("fpSelectNone")!.addEventListener("click", () => {
  titleBtns.forEach(b => { b.classList.remove("checked"); (b.querySelector("input") as HTMLInputElement).checked = false; });
  applyFilters();
});

// --- Other filter controls ---
let searchTimer = 0;
fpSearch.addEventListener("input", () => { clearTimeout(searchTimer); searchTimer = window.setTimeout(applyFilters, 200); });
fpRating.addEventListener("change", applyFilters);
fpMinElo.addEventListener("change", applyFilters);
fpCountry.addEventListener("input", () => { clearTimeout(searchTimer); searchTimer = window.setTimeout(applyFilters, 300); });
fpSex.addEventListener("change", applyFilters);
fpStatus.addEventListener("change", applyFilters);

// --- Show more ---
fpShowMore.addEventListener("click", () => { shownCount += PAGE_SIZE; render(); });

// --- CSV export ---
fpExport.addEventListener("click", () => {
  const headers = ["FIDE ID","Title","Name","Country","Sex","Standard","Rapid","Blitz","Born","Status"];
  const rows = filtered.map(p =>
    [p.id, p.title, p.name, p.country, p.sex, p.std || "", p.rapid || "", p.blitz || "", p.born ?? "", p.active ? "active" : "inactive"]
      .map(v => `"${String(v).replace(/"/g,'""')}"`)
      .join(",")
  );
  const csv = [headers.join(","), ...rows].join("\n");
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([csv], {type:"text/csv"}));
  a.download = `fide-2500-players.csv`;
  a.click();
});

// --- Load data ---
async function init(): Promise<void> {
  fpCount.textContent = "Loading data…";
  try {
    const [dataResp, metaResp] = await Promise.all([
      fetch("/data/fide-players.json"),
      fetch("/data/fide-players.meta.json").catch(() => null),
    ]);
    if (!dataResp.ok) throw new Error(`HTTP ${dataResp.status}`);
    allPlayers = await dataResp.json();
    if (metaResp && metaResp.ok) {
      const meta = await metaResp.json() as Meta;
      if (meta.period) fpUpdated.textContent = `Data as of FIDE ${meta.period} list`;
    }
    fpExport.disabled = false;
    applyFilters();
  } catch (err) {
    fpCount.textContent = "Failed to load player data.";
    fpBody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:1.5rem;color:var(--text-secondary)">Could not load fide-players.json: ${err}</td></tr>`;
  }
}

init();
</script>
</BaseLayout>
