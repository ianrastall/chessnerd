---
import ToolHeader from '../components/ToolHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import manifest from '../../public/data/bullet-brawl-archive/manifest.json';
import { parseBulletBrawlManifest } from '../lib/bullet-brawl-archive';

const entries = parseBulletBrawlManifest(manifest);
const games = entries.reduce((sum, entry) => sum + entry.games, 0);
const latestDate = entries[0].date;
const longDate = (value: string) => new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
const number = (value: number) => value.toLocaleString('en-US');
---
<BaseLayout title="Bullet Brawl Archive" description="Search Chess.com Bullet Brawl events and download PGNs, with event dates and game counts.">
  <main>
    <div id="toolView" class="bullet-brawl-archive">
      <ToolHeader title="Bullet Brawl Archive" icon="bolt" />
      <p class="bb-intro">Bullet Brawl games, organized by event. Each ZIP contains a PGN file.</p>

      <div class="bb-summary">
        <p><strong>{number(entries.length)}</strong> events <span aria-hidden="true">·</span> <strong>{number(games)}</strong> games</p>
        <p>Latest archived event: <time datetime={latestDate}>{latestDate}</time></p>
        <a href="https://github.com/ianrastall/bullet-brawl-archive" target="_blank" rel="noopener noreferrer">Archive on GitHub <span aria-hidden="true">↗</span></a>
      </div>

      <div id="bbControls" class="bb-controls" hidden>
        <div class="bb-search">
          <label for="bbSearch">Search events</label>
          <input id="bbSearch" type="search" placeholder="Date or filename…" autocomplete="off" />
        </div>
        <div class="bb-page-size">
          <label for="bbPageSize">Rows per page</label>
          <select id="bbPageSize">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100" selected>100</option>
          </select>
        </div>
      </div>

      <p id="bbStatus" class="bb-status" role="status">{number(entries.length)} events, newest first</p>
      <div class="bb-table-wrap" role="region" aria-label="Bullet Brawl event downloads" tabindex="0">
        <table class="bb-table">
          <caption class="visually-hidden">Bullet Brawl events, newest first</caption>
          <thead>
            <tr>
              <th scope="col">Event</th>
              <th scope="col">Date</th>
              <th scope="col" class="bb-number">Games</th>
              <th scope="col"><span class="visually-hidden">Download</span></th>
            </tr>
          </thead>
          <tbody id="bbTableBody">
            {entries.map((entry) => (
              <tr data-bb-entry data-search={`${entry.event} ${entry.pgn} ${entry.date} ${longDate(entry.date)}`.toLowerCase()}>
                <th scope="row">
                  <span class="bb-event">Bullet Brawl</span>
                  <span class="bb-filename">{entry.pgn}</span>
                </th>
                <td class="bb-date"><time datetime={entry.date}>{entry.date}</time></td>
                <td class="bb-number">{number(entry.games)}</td>
                <td><a class="btn btn-secondary btn-compact bb-download" href={entry.url} aria-label={`Download Bullet Brawl ${entry.date} PGN ZIP`}><span class="material-icons" aria-hidden="true">download</span>ZIP</a></td>
              </tr>
            ))}
            <tr id="bbEmpty" hidden><td colspan="4">No events match your search. Try another date.</td></tr>
          </tbody>
        </table>
      </div>
      <nav id="bbPagination" class="bb-pagination" aria-label="Archive pages" hidden>
        <button id="bbPrevPage" type="button" class="btn btn-secondary" disabled>Previous</button>
        <span id="bbPageInfo">Page 1 of 1</span>
        <button id="bbNextPage" type="button" class="btn btn-secondary">Next</button>
      </nav>
      <p class="bb-note">This is a growing collection; older events are still being added.</p>
      <noscript><p class="bb-note">All events are listed. Enable JavaScript for search and pagination.</p></noscript>
    </div>
  </main>

  <style>
    .bb-intro { margin-bottom: 1rem; }
    .bb-summary { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: 1.5rem; color: var(--text-secondary); font-size: 0.9rem; }
    .bb-summary strong { color: var(--text-primary); }
    .bb-summary p:first-child span { padding: 0 0.4rem; }
    .bb-controls { display: flex; align-items: end; gap: 1rem; margin-bottom: 1rem; }
    .bb-controls[hidden], .bb-pagination[hidden] { display: none; }
    .bb-search { flex: 1; }
    .bb-controls label { display: block; font-size: 0.9rem; margin-bottom: 0.4rem; }
    .bb-controls input, .bb-controls select { width: 100%; min-height: 2.75rem; padding: 0.6rem 0.75rem; color: var(--text-primary); background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 6px; font: inherit; }
    .bullet-brawl-archive :is(input, select, a, button, [tabindex]):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .bb-status { margin-bottom: 0.75rem; color: var(--text-secondary); font-size: 0.9rem; }
    .bb-table-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 8px; }
    .bb-table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); }
    .bb-table th, .bb-table td { padding: 0.85rem 1rem; text-align: left; border-bottom: 1px solid var(--border-color); }
    .bb-table thead th { background: var(--bg-tertiary); color: var(--text-secondary); font-size: 0.875rem; font-weight: 600; }
    .bb-table tbody th { font-weight: 400; min-width: 18rem; }
    .bb-table tbody tr:hover { background: var(--bg-tertiary); }
    .bb-event { display: block; font-weight: 600; }
    .bb-filename { display: block; margin-top: 0.2rem; font-size: 0.875rem; color: var(--text-secondary); overflow-wrap: anywhere; }
    .bb-table .bb-number { text-align: right; font-variant-numeric: tabular-nums; }
    .bb-date { white-space: nowrap; font-variant-numeric: tabular-nums; font-size: 0.9rem; }
    .bb-download { white-space: nowrap; min-height: 2.5rem; }
    .bb-pagination { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
    .bb-pagination span, .bb-note { color: var(--text-secondary); font-size: 0.9rem; }
    .bb-pagination button:disabled { opacity: 0.45; cursor: default; }
    .bb-note { margin-top: 1rem; }
    @media (max-width: 600px) {
      .bb-controls { align-items: stretch; flex-direction: column; }
      .bb-table th, .bb-table td { padding: 0.75rem; }
      .bb-pagination { justify-content: center; gap: 0.6rem; }
    }
  </style>
  <script>
    import '../scripts/bullet-brawl-archive';
  </script>
</BaseLayout>
