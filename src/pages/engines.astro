---
import ToolHeader from '../components/ToolHeader.astro';
import OverviewTabs from '../components/OverviewTabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { engineArchitectures, enginePlatforms } from '../lib/engine-downloads';
---
<BaseLayout title="Engine Releases" description="Browse current and past releases from open-source chess engines on GitHub.">
  <main>
    <div id="toolView">
      <ToolHeader title="Engine Releases" icon="new_releases" />
      <OverviewTabs currentPage="engines" />

      <p class="engines-note">
        <a href="/data/engines/github-chess-engines.json" download>Download the GitHub chess engine catalogue (JSON)</a>.
        Includes projects without GitHub releases.
      </p>

      <div class="options-panel">
        <div class="engines-controls">
          <div class="option-group engines-search">
            <label for="enginesSearch">Search</label>
            <input id="enginesSearch" type="search" placeholder="Engine, version, author…" autocomplete="off" aria-label="Search engines" />
          </div>
          <div class="option-group">
            <label for="enginesScope">Releases</label>
            <select id="enginesScope" disabled>
              <option value="latest">Latest per engine</option>
              <option value="all">All versions</option>
            </select>
          </div>
          <div class="option-group">
            <label for="enginesSort">Sort</label>
            <select id="enginesSort" aria-label="Sort order">
              <option value="released">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="name">Name (A&ndash;Z)</option>
              <option value="stars">Most stars</option>
            </select>
          </div>
          <div class="option-group">
            <label for="enginesPlatform">Platform</label>
            <select id="enginesPlatform">
              <option value="">All platforms</option>
              {enginePlatforms.map(({ value, label }) => <option value={value}>{label}</option>)}
            </select>
          </div>
          <div class="option-group">
            <label for="enginesArchitecture">Architecture</label>
            <select id="enginesArchitecture">
              <option value="">All architectures</option>
              {engineArchitectures.map(({ value, label }) => <option value={value}>{label}</option>)}
            </select>
          </div>
        </div>
      </div>

      <div class="status-bar engines-status">
        <div id="enginesStatus" role="status">Loading releases...</div>
        <time id="enginesGenerated"></time>
        <nav id="enginesPages" class="engines-pages" aria-label="Engine release pages" hidden>
          <button id="enginesPrevious" class="btn btn-secondary btn-compact" type="button">Previous</button>
          <button id="enginesNext" class="btn btn-secondary btn-compact" type="button">Next</button>
        </nav>
      </div>

      <section id="enginesList" class="engines-list" aria-label="Engine releases"></section>

      <p class="engines-note">
        Releases refresh daily from each engine’s public GitHub repository.
        Platform and architecture labels describe the available downloads.
      </p>
    </div>
  </main>

  <!-- Global: the list is built dynamically in JS, so scoped styles would never
       reach it. All selectors here are .engines-* namespaced, so this is safe. -->
  <style is:global>
    .engines-controls {
      display: grid;
      grid-template-columns: minmax(0, 2fr) repeat(4, minmax(9rem, 1fr));
      gap: 1rem;
      align-items: end;
    }

    .engines-controls :is(input, select) {
      width: 100%;
      min-width: 0;
      min-height: 2.2rem;
      padding: 0.35rem 0.6rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      color: var(--text-primary);
    }

    .engines-controls :is(input, select):focus {
      outline: none;
      border-color: var(--accent);
    }

    .engines-status {
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .engines-pages {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .engines-pages[hidden] {
      display: none;
    }

    .engines-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
      gap: 0.85rem;
    }

    .engine-card > *,
    .engine-downloads li > * {
      min-width: 0;
    }

    .engine-card {
      display: grid;
      gap: 0.6rem;
      align-content: start;
      padding: 1rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
    }

    .engine-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }

    .engine-identity {
      display: flex;
      align-items: center;
      min-width: 0;
      gap: 0.6rem;
    }

    .engine-logo {
      width: 2.25rem;
      height: 2.25rem;
      flex: none;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: var(--bg-tertiary);
      display: grid;
      place-items: center;
    }

    .engine-logo img {
      width: 100%;
      height: 100%;
      padding: 0.12rem;
      object-fit: contain;
    }

    .engine-logo .material-icons {
      font-size: 1.15rem;
      color: var(--text-secondary);
    }

    .engine-name {
      color: var(--text-primary);
      font-weight: 650;
      font-size: 1.05rem;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .engine-stars {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      color: var(--text-secondary);
      font-size: 0.82rem;
      white-space: nowrap;
    }

    .engine-stars .material-icons {
      font-size: 0.95rem;
    }

    .engine-author {
      color: var(--text-secondary);
      font-size: 0.85rem;
      overflow-wrap: anywhere;
    }

    .engine-desc {
      color: var(--text-primary);
      font-size: 0.9rem;
      line-height: 1.4;
    }

    .engine-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .engine-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.05rem 0.5rem;
      border: 1px solid var(--border-color);
      border-radius: 999px;
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      font-size: 0.75rem;
      overflow-wrap: anywhere;
    }

    .engine-tag img, .engine-tag .material-icons, .engine-download-title img, .engine-download-title .material-icons {
      width: 0.95rem;
      height: 0.95rem;
      font-size: 0.95rem;
      flex: none;
    }

    [data-theme='dark'] .engine-icon-mono {
      filter: invert(1);
    }

    .engine-version-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem;
      padding-block: 0.4rem;
      border-block: 1px solid var(--border-color);
      font-size: 0.85rem;
      color: var(--text-primary);
    }

    .engine-version {
      min-width: 0;
      font-weight: 650;
      overflow-wrap: anywhere;
    }

    .engine-release-date {
      margin-left: auto;
      color: var(--text-secondary);
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .engine-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .engine-downloads summary {
      cursor: pointer;
      color: var(--accent);
      font-size: 0.82rem;
    }

    .engine-download-groups {
      margin: 0.5rem 0 0;
      max-height: 320px;
      overflow: auto;
    }

    .engine-download-title {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin: 0 0 0.25rem;
      color: var(--text-primary);
      font-size: 0.8rem;
      font-weight: 650;
    }

    .engine-downloads ul {
      list-style: none;
      margin: 0 0 0.75rem;
      padding: 0;
      display: grid;
      gap: 0.3rem;
    }

    .engine-downloads ul:last-child {
      margin-bottom: 0;
    }

    .engine-downloads li {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 0.8rem;
    }

    .engine-downloads a {
      color: var(--accent);
      overflow-wrap: anywhere;
    }

    .engine-downloads .asset-meta {
      color: var(--text-secondary);
      text-align: right;
      max-width: 42%;
    }

    .engines-empty {
      grid-column: 1 / -1;
      padding: 1.25rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-secondary);
    }

    .engines-note {
      margin-top: 1.5rem;
      color: var(--text-secondary);
      font-size: 0.82rem;
      line-height: 1.5;
    }

    @media (max-width: 1250px) {
      .engines-controls {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .engines-search {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 410px) {
      .engines-controls {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>

  <script>
    import '../scripts/engines';
  </script>
</BaseLayout>
