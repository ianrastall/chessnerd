---
import ToolHeader from '../components/ToolHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Download {
  id: string;
  file: string;
  size: number;
  href: string;
  date: string;
}

function pd(id: string, file: string, size: number, date: string): Download {
  return { id, file, size, href: `https://pixeldrain.com/u/${id}`, date };
}

function fmtSize(bytes: number): string {
  if (bytes >= 1_000_000_000) return `${(bytes / 1_073_741_824).toFixed(2)} GB`;
  if (bytes >= 1_000_000) return `${(bytes / 1_048_576).toFixed(1)} MB`;
  return `${(bytes / 1024).toFixed(0)} KB`;
}

function fmtDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

interface Section {
  title: string;
  icon: string;
  items: Download[];
}

const sections: Section[] = [
  {
    title: 'General Databases',
    icon: 'public',
    items: [
      pd('4YDEsXpN', 'twic-public-260905.zip', 909_016_671, '2026-09-05'),
      pd('VfsSt1At', 'historical.zip', 28_197_461, '2026-09-05'),
    ]
  },
  {
    title: 'Regional Databases',
    icon: 'flag',
    items: [
      pd('VRrTJ86V', 'arg-base.zip', 8_204_760, '2026-09-05'),
      pd('CAodJC66', 'brit-base.zip', 28_543_793, '2026-09-05'),
      pd('1yAVW212', 'rus-base.zip', 31_553_746, '2026-09-05'),
    ]
  },
  {
    title: 'Online Databases',
    icon: 'language',
    items: [
      pd('9s3334cv', 'cc-2800-2603.zip', 34_535_469, '2026-09-05'),
      pd('CanR8Bmh', 'cc-2800-2604.zip', 32_510_614, '2026-09-05'),
      pd('zXweh8Kz', 'cc-2800-2605.zip', 37_794_112, '2026-09-05'),
      pd('L9bzPcD4', 'cc-2800-2606.zip', 32_498_953, '2026-09-05'),
      pd('efVTkZ3w', 'cc-2800-2607.zip', 40_453_333, '2026-09-05'),
      pd('iVWzmddP', 'li-2800-2605.zip', 928_108, '2026-09-05'),
      pd('3uKPRhbU', 'li-2800-2606.zip', 1_004_634, '2026-09-05'),
      pd('sbD2jgS6', 'li-2800-2607.zip', 1_056_078, '2026-09-05'),
    ]
  }
];
---
<BaseLayout title="PGN Downloads" description="Download curated PGN collections for chess research and analysis.">
  <main>
    <div id="toolView">
      <ToolHeader title="PGN Downloads" icon="cloud_download" />

      <div class="search-box">
        <label class="visually-hidden" for="fileSearch">Filter files</label>
        <input type="text" id="fileSearch" placeholder="Filter files..." autocomplete="off" aria-label="Filter files" />
      </div>

      {sections.map((section) => (
        <section class="dl-section">
          <h2 class="dl-section-title">
            <span class="material-icons" aria-hidden="true">{section.icon}</span>
            {section.title}
          </h2>

          <div class="io-container table-shell">
            <table class="download-table">
              <thead>
                <tr>
                  <th>File</th>
                  <th>Size</th>
                  <th>Updated</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody class="fileList">
                {section.items.map((item) => (
                  <tr>
                    <td><strong>{item.file}</strong></td>
                    <td class="dl-size">{fmtSize(item.size)}</td>
                    <td class="dl-date">{fmtDate(item.date)}</td>
                    <td>
                      <a href={item.href} class="btn btn-primary btn-compact" target="_blank" rel="noopener noreferrer">
                        Download
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </main>

  <style>
    .dl-section {
      margin-bottom: 2.5rem;
    }

    .dl-section-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    .dl-section-title .material-icons {
      font-size: 1.3rem;
      color: var(--accent);
    }

    .table-shell {
      display: block;
      overflow-x: auto;
    }

    .download-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--bg-secondary);
      border-radius: 8px;
      overflow: hidden;
    }

    .download-table th,
    .download-table td {
      padding: 0.85rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
    }

    .download-table th {
      background: var(--bg-tertiary);
      color: var(--accent);
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .download-table tr:last-child td {
      border-bottom: none;
    }

    .download-table tbody tr:hover {
      background: var(--bg-tertiary);
    }

    .dl-size,
    .dl-date {
      white-space: nowrap;
      color: var(--text-secondary);
    }
  </style>

  <script>
    import '../scripts/pgn-downloads';
  </script>
</BaseLayout>
