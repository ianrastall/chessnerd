---
import ToolHeader from '../components/ToolHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Download {
  id: string;
  file: string;
  name?: string;
  description?: string;
  size: number;
  href: string;
  date: string;
}

function pd(id: string, file: string, size: number, date: string, details: Pick<Download, 'name' | 'description'> = {}): Download {
  return { id, file, size, href: `https://pixeldrain.com/u/${id}`, date, ...details };
}

function fmtSize(bytes: number): string {
  if (bytes >= 1_000_000_000) return `${(bytes / 1_073_741_824).toFixed(2)} GB`;
  if (bytes >= 1_000_000) return `${(bytes / 1_048_576).toFixed(1)} MB`;
  return `${(bytes / 1024).toFixed(0)} KB`;
}

function fmtDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

interface Section {
  title: string;
  description?: string;
  items: Download[];
}

const sections: Section[] = [
  {
    title: 'General Databases',
    items: [
      pd('4YDEsXpN', 'twic-public-260905.zip', 909_016_671, '2026-09-05', {
        name: 'Publicly-Available TWIC',
        description: 'All publicly available TWIC issues, starting at issue 920.',
      }),
      pd('VfsSt1At', 'historical.zip', 28_197_461, '2026-09-05', {
        name: 'Historical Games',
        description: 'A collection of historical chess games.',
      }),
    ]
  },
  {
    title: 'Regional Databases',
    items: [
      pd('VRrTJ86V', 'arg-base.zip', 8_204_760, '2026-09-05', {
        name: 'ARG-Base',
        description: 'A collection of games from Argentine chess.',
      }),
      pd('CAodJC66', 'brit-base.zip', 28_543_793, '2026-09-05', {
        name: 'BRIT-Base',
        description: 'A collection of games from British chess.',
      }),
      pd('1yAVW212', 'rus-base.zip', 31_553_746, '2026-09-05', {
        name: 'RUS-Base',
        description: 'A collection of games from Russian chess.',
      }),
    ]
  },
  {
    title: 'Online Databases',
    description: '2800+, 10–150 moves, no 960, bots, or bullet.',
    items: [
      pd('9s3334cv', 'cc-2800-2603.zip', 34_535_469, '2026-09-05'),
      pd('CanR8Bmh', 'cc-2800-2604.zip', 32_510_614, '2026-09-05'),
      pd('zXweh8Kz', 'cc-2800-2605.zip', 37_794_112, '2026-09-05'),
      pd('L9bzPcD4', 'cc-2800-2606.zip', 32_498_953, '2026-09-05'),
      pd('efVTkZ3w', 'cc-2800-2607.zip', 40_453_333, '2026-09-05'),
      pd('iVWzmddP', 'li-2800-2605.zip', 928_108, '2026-09-05'),
      pd('3uKPRhbU', 'li-2800-2606.zip', 1_004_634, '2026-09-05'),
      pd('sbD2jgS6', 'li-2800-2607.zip', 1_056_078, '2026-09-05'),
    ]
  }
];
---
<BaseLayout title="PGN Downloads" description="Download curated PGN collections for chess research and analysis.">
  <main>
    <div id="toolView">
      <ToolHeader title="PGN Downloads" icon="cloud_download" />

      <div class="search-box">
        <label class="visually-hidden" for="fileSearch">Filter files</label>
        <input type="text" id="fileSearch" placeholder="Filter files..." autocomplete="off" aria-label="Filter files" />
      </div>

      <div class="io-container table-shell">
        <table class="download-table">
          <thead>
            <tr>
              <th scope="col">Collection / File</th>
              <th scope="col">Size</th>
              <th scope="col">Updated</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          {sections.map((section) => (
            <tbody class="fileList dl-section">
              <tr class="section-header">
                <th scope="rowgroup" colspan="4">
                  <strong>{section.title}</strong>
                  {section.description && <span class="section-desc"> — {section.description}</span>}
                </th>
              </tr>
              {section.items.map((item) => (
                <tr data-file={item.file}>
                  <td>
                    <strong>{item.name ?? item.file}</strong>
                    {item.description && <span class="dl-description">{item.description}</span>}
                  </td>
                  <td class="dl-size">{fmtSize(item.size)}</td>
                  <td class="dl-date">{fmtDate(item.date)}</td>
                  <td>
                    <a href={item.href} class="btn btn-primary btn-compact" target="_blank" rel="noopener noreferrer">
                      Download
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </main>

  <style>
    .table-shell {
      display: block;
      overflow-x: auto;
    }

    .download-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--bg-secondary);
      border-radius: 8px;
      overflow: hidden;
    }

    .download-table th,
    .download-table td {
      padding: 0.85rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
    }

    .download-table th {
      background: var(--bg-tertiary);
      color: var(--accent);
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .download-table tbody:last-child tr:last-child td {
      border-bottom: none;
    }

    .download-table tbody tr:not(.section-header):hover {
      background: var(--bg-tertiary);
    }

    .section-header th {
      padding: 0.7rem 1rem;
      color: var(--text-primary);
      font-size: 1.05rem;
      text-transform: none;
      letter-spacing: normal;
    }

    .section-desc {
      color: var(--text-secondary);
      font-weight: 400;
      font-size: 0.9rem;
    }

    .download-table td:first-child {
      min-width: 14rem;
    }

    .dl-description {
      display: block;
      margin-top: 0.25rem;
      color: var(--text-secondary);
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .dl-size,
    .dl-date {
      white-space: nowrap;
      color: var(--text-secondary);
    }
  </style>

  <script>
    import '../scripts/pgn-downloads';
  </script>
</BaseLayout>
