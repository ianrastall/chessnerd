---
import '../styles/global.css';
import '../styles/jupiter.css';
import Appearance from '../components/jupiter/Appearance.astro';
import { ArrowUpRight, House, Search } from '@lucide/astro';
import { navigation } from '../data/navigation';
interface Props { title:string; description?:string; }
const {title,description='Find chess games, explore player histories, and use free chess tools.'}=Astro.props;
const current=Astro.url.pathname.replace(/\/index\.html$/, '/');
const active=(href:string)=>current === href || current === href.replace('.html','');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} /><title>{title === 'Chess Nerd' ? title : `${title} · Chess Nerd`}</title>
    <link rel="icon" href="/favicon.ico" /><link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <slot name="head" />
    <script is:inline>
      try {
        const theme=localStorage.getItem('chessnerd-theme') || localStorage.getItem('theme');
        document.documentElement.dataset.theme=theme === 'light' ? 'light' : 'dark';
        const accent=localStorage.getItem('chessnerd-accent') || localStorage.getItem('accentColor');
        if (accent && /^#[0-9a-f]{6}$/i.test(accent)) {
          document.documentElement.style.setProperty('--accent',accent);
          if (!localStorage.getItem('chessnerd-accent')) localStorage.setItem('chessnerd-accent',accent);
        }
        if (theme && !localStorage.getItem('chessnerd-theme')) localStorage.setItem('chessnerd-theme',theme);
      } catch { /* Storage is optional. */ }
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-466855WRX3"></script>
    <script is:inline>
      window.dataLayer=window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js',new Date()); gtag('config','G-466855WRX3');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Chess Nerd home"><span class="brand-mark" aria-hidden="true">♞</span><span>Chess Nerd<small>A Jupiter project</small></span></a>
      <nav class="site-network" aria-label="Jupiter websites"><a href="https://text-utils.net">Text Utilities <ArrowUpRight size={13} aria-hidden="true" /></a><a class="network-current" href="/" aria-current="true">Chess Nerd</a><a href="https://bookstacks.org">Bookstacks <ArrowUpRight size={13} aria-hidden="true" /></a></nav>
      <Appearance />
    </header>
    <div class="jupiter-workspace">
      <aside class="jupiter-sidebar" aria-label="Chess Nerd navigation">
        <a class:list={['overview-link',{active:current === '/'}]} href="/" aria-current={current === '/' ? 'page' : undefined}><House size={16} aria-hidden="true" /> Overview</a>
        <details class="site-navigation" open><summary>Browse Chess Nerd</summary>
          <label class="visually-hidden" for="navigation-search">Find a page or tool</label><div class="nav-search"><Search size={14} aria-hidden="true" /><input type="search" id="navigation-search" placeholder="Find a page or tool…" /></div>
          <nav aria-label="Pages and tools">{navigation.map(group=><section class="nav-group"><h2>{group.name}</h2>{group.links.map(link=><a data-navigation-item data-search={`${link.name} ${link.keywords || ''}`.toLowerCase()} href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.name}</a>)}</section>)}</nav>
          <p id="navigation-empty" hidden>No matching pages.</p>
        </details>
        <div class="sidebar-note"><strong>A public chess library.</strong><p>Free tools, preserved games and open data. Downloads link to their source archives.</p><a href="https://github.com/ianrastall/chessnerd">Source on GitHub ↗</a></div>
      </aside>
      <div class="jupiter-content" id="main-content" tabindex="-1">
        <noscript><p class="notice">Interactive search and chess tools need JavaScript. Recent archive downloads and navigation remain available below.</p></noscript>
        <slot />
        <footer class="site-footer"><div><strong>Chess Nerd</strong><p>Tools, games and chess history.</p></div><nav aria-label="Project links"><a href="https://github.com/ianrastall/chessnerd">Source on GitHub ↗</a><a href="https://ko-fi.com/ianrastall">Support this project ↗</a><a href="mailto:moving.form.of.dust@gmail.com">Contact</a></nav></footer>
      </div>
    </div>
    <script>
      const search=document.querySelector<HTMLInputElement>('#navigation-search')!;
      const navigation=document.querySelector<HTMLDetailsElement>('.site-navigation')!;
      const desktop=matchMedia('(min-width:901px)');navigation.open=desktop.matches;desktop.addEventListener('change',()=>navigation.open=desktop.matches);
      search.addEventListener('input',()=>{ const words=search.value.toLowerCase().trim().split(/\s+/);let count=0;
        document.querySelectorAll<HTMLElement>('[data-navigation-item]').forEach(a=>{a.hidden=!words.every(word=>a.dataset.search!.includes(word));if(!a.hidden)count++;});
        document.querySelectorAll<HTMLElement>('.nav-group').forEach(group=>group.hidden=!group.querySelector('a:not([hidden])'));
        document.querySelector<HTMLElement>('#navigation-empty')!.hidden=!!count;
      });
    </script>
  </body>
</html>
