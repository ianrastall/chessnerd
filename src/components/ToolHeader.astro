---
import ToolIcon from './ToolIcon.astro';
import { ArrowLeft } from '@lucide/astro';
interface Props {
  title: string;
  icon: string;
  backHref?: string;
}

const { title, icon, backHref = '/' } = Astro.props;
---
<div class="tool-header">
  <div class="tool-title">
    <ToolIcon name={icon} />
    <h1>{title}</h1>
  </div>
  <div class="tool-actions">
    <a id="backButton" class="btn btn-secondary btn-compact" href={backHref}>
      <ArrowLeft size={14} aria-hidden="true" />
      Back
    </a>
  </div>
</div>
